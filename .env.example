# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgres://username:password@localhost:5432/verdika_db
# SQLITE_PATH=./data/verdika.sqlite

# Brevo (formerly Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@domain.com
BREVO_FROM_NAME="Verdika Security"

# SMTP Fallback Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI / LLM Agent Services (if applicable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
